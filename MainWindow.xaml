<Window x:Class="Organizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Organizer.ViewModels"
        xmlns:conv="clr-namespace:Organizer.Converters"
        xmlns:loc="clr-namespace:Organizer"
        Title="Organizer" Height="680" Width="1060"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:LogTypeToColorConverter   x:Key="LogColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colores -->
        <SolidColorBrush x:Key="BgShell"    Color="#111318"/>
        <SolidColorBrush x:Key="BgSidebar"  Color="#0D0F14"/>
        <SolidColorBrush x:Key="BgCenter"   Color="#111318"/>
        <SolidColorBrush x:Key="BgRight"    Color="#0D0F14"/>
        <SolidColorBrush x:Key="BgCard"     Color="#181B23"/>
        <SolidColorBrush x:Key="BgInput"    Color="#0D0F14"/>
        <SolidColorBrush x:Key="BgHover"    Color="#1C2030"/>
        <SolidColorBrush x:Key="BgSelected" Color="#161B2E"/>
        <SolidColorBrush x:Key="Blue"       Color="#4F8EF7"/>
        <SolidColorBrush x:Key="Purple"     Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Green"      Color="#34D399"/>
        <SolidColorBrush x:Key="Red"        Color="#F87171"/>
        <SolidColorBrush x:Key="Orange"     Color="#FB923C"/>
        <SolidColorBrush x:Key="T1"         Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T2"         Color="#64748B"/>
        <SolidColorBrush x:Key="T3"         Color="#4A5568"/>
        <SolidColorBrush x:Key="Border"     Color="#1A1E2C"/>

        <!-- Botón primario azul -->
        <Style x:Key="BtnBlue" TargetType="Button">
            <Setter Property="Background"      Value="#4F8EF7"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6BA3F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A72D8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1E2C"/>
                                <Setter Property="Foreground" Value="#2E3450"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón purple -->
        <Style x:Key="BtnPurple" TargetType="Button" BasedOn="{StaticResource BtnBlue}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9D5CF6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#6027C4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A1E2C"/>
                    <Setter Property="Foreground" Value="#2E3450"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón danger -->
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BtnBlue}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A1E2C"/>
                    <Setter Property="Foreground" Value="#2E3450"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón ghost -->
        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBlue}">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#8899BB"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2030"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón ventana -->
        <Style x:Key="BtnWin" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#6B7A99"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2030"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnWin}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D"/>
                    <Setter Property="Foreground" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nav lateral -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground"      Value="#6B7A99"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Margin"          Value="8,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Grid.Column="0" CornerRadius="2"
                                        Background="Transparent" VerticalAlignment="Center" Height="16"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#161B2E"/>
                                <Setter TargetName="Bar" Property="Background" Value="#4F8EF7"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#13172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#8899BB"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,5"/>
        </Style>

        <!-- ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Stat card -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"       Value="#181B23"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="BorderBrush"      Value="#1A1E2C"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="14,12"/>
        </Style>

        <!-- Section card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"       Value="#181B23"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="BorderBrush"      Value="#1A1E2C"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="18,16"/>
            <Setter Property="Margin"           Value="0,0,0,10"/>
        </Style>

    </Window.Resources>

    <!-- Shell -->
    <Border Background="#111318" CornerRadius="12" BorderBrush="#1A1E2C" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ══ SIDEBAR ══════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="#0D0F14"
                    BorderBrush="#1A1E2C" BorderThickness="0,0,1,0"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="18,0">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="#161B2E" BorderBrush="#252D4A" BorderThickness="1">
                            <TextBlock Text="🗂" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Higea" Foreground="#CBD5E1"
                                       FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{x:Static loc:Loc+UI.AppSubtitle}" Foreground="#4A5568" FontSize="9.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{x:Static loc:Loc+UI.NavTools}" Foreground="#4A5568"
                                   FontSize="9.5" FontWeight="Bold"
                                   Margin="22,10,0,4"/>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     GroupName="Nav" IsChecked="True"
                                     Checked="OrganizerTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="13"/>
                                <TextBlock Text="{x:Static loc:Loc+UI.NavOrganizer}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     GroupName="Nav" Checked="CleanerTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="13"/>
                                <TextBlock Text="{x:Static loc:Loc+UI.NavCleaner}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavBtn}"
                                     GroupName="Nav" Checked="GamingTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="13"/>
                                <TextBlock Text="{x:Static loc:Loc+UI.NavGaming}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar footer -->
                    <Border Grid.Row="2" Padding="14,10"
                            BorderBrush="#13172A" BorderThickness="0,1,0,0">
                        <TextBlock Foreground="#4A5568"
                                   FontSize="9.5" HorizontalAlignment="Center">
                            <Run Text="Created by Felix Loaiza" Foreground="#3D4F72"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ PANEL CENTRAL ════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titlebar -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="18,0,8,0">
                        <TextBlock x:Name="TitleLabel" Text="{x:Static loc:Loc+UI.TitleOrganizer}"
                                   Foreground="#4A5568" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnWin}"  Content="─" Click="Minimize_Click" Margin="0,0,2,0"/>
                            <Button Style="{StaticResource BtnWin}"  Content="□" Click="Maximize_Click" Margin="0,0,2,0"/>
                            <Button Style="{StaticResource BtnClose}" Content="✕" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido central -->
                <Grid Grid.Row="1" Margin="16,0,16,16">

                    <!-- ── ORGANIZER ────────────────────────────────────────── -->
                    <Grid x:Name="OrganizerPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{x:Static loc:Loc+UI.OrgTitle}" Foreground="#CBD5E1"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{x:Static loc:Loc+UI.OrgSubtitle}"
                                       Foreground="#4A5568" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Carpeta -->
                        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Static loc:Loc+UI.OrgTargetFolder}"
                                           Foreground="#4A5568" FontSize="9.5" FontWeight="Bold"/>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0D0F14" CornerRadius="7"
                                            BorderBrush="#1A1E2C" BorderThickness="1" Padding="12,0">
                                        <TextBlock Text="{Binding SourcePath, FallbackValue={x:Static loc:Loc+UI.OrgNoFolder}}"
                                                   Foreground="#7C8BA8" FontSize="12"
                                                   VerticalAlignment="Center" Height="32"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="{x:Static loc:Loc+UI.OrgBrowse}"
                                            Style="{StaticResource BtnGhost}"
                                            Command="{Binding BrowseFolderCommand}"
                                            Padding="12,7"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Stats -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.OrgStatMoved}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding FilesMoved}"
                                               Foreground="#34D399" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.OrgStatSkipped}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding FilesSkipped}"
                                               Foreground="#FB923C" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.OrgStatStatus}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding OrganizerStatus}"
                                               Foreground="#7C8BA8" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Acciones -->
                        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{x:Static loc:Loc+UI.OrgActions}" Foreground="#4A5568"
                                           FontSize="9.5" FontWeight="Bold"/>

                                <Button Grid.Row="2"
                                        Style="{StaticResource BtnBlue}"
                                        Command="{Binding OrganizeFolderCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static loc:Loc+UI.OrgBtnFolder}" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="4"
                                        Style="{StaticResource BtnPurple}"
                                        Command="{Binding OrganizePCCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static loc:Loc+UI.OrgBtnPC}" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <!-- Loading overlay -->
                                <Border Grid.Row="2" Grid.RowSpan="3"
                                        Background="#181B23CC" CornerRadius="7"
                                        Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static loc:Loc+UI.OrgOrganizing}"
                                               Foreground="#4F8EF7" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── CLEANER ───────────────────────────────────────────── -->
                    <Grid x:Name="CleanerPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{x:Static loc:Loc+UI.ClnTitle}" Foreground="#CBD5E1"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{x:Static loc:Loc+UI.ClnSubtitle}"
                                       Foreground="#4A5568" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Opciones -->
                        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Loc+UI.ClnWhatToClean}" Foreground="#4A5568"
                                           FontSize="9.5" FontWeight="Bold" Margin="0,0,0,12"/>
                                <CheckBox Content="{x:Static loc:Loc+UI.ClnTempFiles}"
                                          IsChecked="{Binding CleanTemp}"/>
                                <CheckBox Content="{x:Static loc:Loc+UI.ClnRecycleBin}"
                                          IsChecked="{Binding EmptyRecycleBin}"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat -->
                        <Border Grid.Row="2" Style="{StaticResource StatCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Loc+UI.ClnStatStatus}" Foreground="#4A5568"
                                           FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CleanerStatus}"
                                           Foreground="#7C8BA8" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Acción -->
                        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Static loc:Loc+UI.ClnAction}" Foreground="#4A5568"
                                           FontSize="9.5" FontWeight="Bold"/>
                                <Button Grid.Row="2" Style="{StaticResource BtnRed}"
                                        Command="{Binding CleanCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,10">
                                    <TextBlock Text="{x:Static loc:Loc+UI.ClnBtnClean}" FontSize="12"/>
                                </Button>
                                <Border Grid.Row="2" Background="#181B23CC" CornerRadius="7"
                                        Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static loc:Loc+UI.ClnCleaning}"
                                               Foreground="#F87171" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── GAMING ────────────────────────────────────────────── -->
                    <Grid x:Name="GamingPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{x:Static loc:Loc+UI.GamTitle}" Foreground="#CBD5E1"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{x:Static loc:Loc+UI.GamSubtitle}"
                                       Foreground="#4A5568" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Stats gaming -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamStatDeleted}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding GamingFilesDeleted}"
                                               Foreground="#34D399" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamStatFreed}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding GamingBytesFreed}"
                                               Foreground="#8B5CF6" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamStatStatus}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding GamingStatus}"
                                               Foreground="#7C8BA8" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Opciones gaming -->
                        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamCleanup}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <CheckBox Content="{x:Static loc:Loc+UI.GamNvidiaCache}"
                                              IsChecked="{Binding GamingNvidiaCache}"/>
                                    <CheckBox Content="{x:Static loc:Loc+UI.GamPrefetch}"
                                              IsChecked="{Binding GamingPrefetch}"/>
                                    <CheckBox Content="{x:Static loc:Loc+UI.GamFreeRam}"
                                              IsChecked="{Binding GamingFreeRam}"/>
                                </StackPanel>

                                <Border Grid.Column="1" Width="1" Background="#1A1E2C"
                                        VerticalAlignment="Stretch" Margin="0,4"/>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamPerformance}" Foreground="#4A5568"
                                               FontSize="9.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <CheckBox Content="{x:Static loc:Loc+UI.GamHighPerf}"
                                              IsChecked="{Binding GamingHighPerf}"/>
                                    <CheckBox Content="{x:Static loc:Loc+UI.GamFlushDns}"
                                              IsChecked="{Binding GamingFlushDns}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Acción gaming -->
                        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{x:Static loc:Loc+UI.GamAction}" Foreground="#4A5568"
                                           FontSize="9.5" FontWeight="Bold"/>
                                <Button Grid.Row="2" Style="{StaticResource BtnPurple}"
                                        Command="{Binding OptimizeGamingCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,10">
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamBtnOptimize}" FontSize="12"/>
                                </Button>
                                <Border Grid.Row="2" Background="#181B23CC" CornerRadius="7"
                                        Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static loc:Loc+UI.GamOptimizing}"
                                               Foreground="#8B5CF6" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ══ PANEL DERECHO — ACTIVITY LOG ═══════════════════════════════ -->
            <Border Grid.Column="2" Background="#0D0F14"
                    BorderBrush="#1A1E2C" BorderThickness="1,0,0,0"
                    CornerRadius="0,12,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header log -->
                    <Border Grid.Row="0" BorderBrush="#1A1E2C" BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Loc+UI.LogTitle}" Foreground="#CBD5E1"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Static loc:Loc+UI.LogSubtitle}"
                                           Foreground="#4A5568" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="{x:Static loc:Loc+UI.LogClear}"
                                    Style="{StaticResource BtnGhost}"
                                    x:Name="ClearLogBtn"
                                    Click="ClearLogBtn_Click"
                                    Padding="8,4" FontSize="10"/>
                        </Grid>
                    </Border>

                    <!-- Log unificado según panel activo -->
                    <Grid Grid.Row="1">

                        <!-- Log Organizer -->
                        <ScrollViewer x:Name="OrganizerLogScroll"
                                      VerticalScrollBarVisibility="Auto" Margin="6,6,4,6">
                            <ItemsControl ItemsSource="{Binding OrganizerLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,7" CornerRadius="6"
                                                Background="#13172A">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Type, Converter={StaticResource LogColorConverter}}"
                                                       FontSize="11.5" FontFamily="Cascadia Code, Consolas"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Log Cleaner -->
                        <ScrollViewer x:Name="CleanerLogScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Margin="6,6,4,6">
                            <ItemsControl ItemsSource="{Binding CleanerLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,7" CornerRadius="6"
                                                Background="#13172A">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Type, Converter={StaticResource LogColorConverter}}"
                                                       FontSize="11.5" FontFamily="Cascadia Code, Consolas"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Log Gaming -->
                        <ScrollViewer x:Name="GamingLogScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Margin="6,6,4,6">
                            <ItemsControl ItemsSource="{Binding GamingLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,2" Padding="10,7" CornerRadius="6"
                                                Background="#13172A">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Type, Converter={StaticResource LogColorConverter}}"
                                                       FontSize="11.5" FontFamily="Cascadia Code, Consolas"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
